<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>MetaRPC.Copier</PackageId>
    <Version>1.0.0</Version>
    <Authors>MetaRPC</Authors>
    <Company>MetaRPC</Company>
    <Description>Official C# SDK for MetaRPC Trade Copier high-performance trade replication via gRPC</Description>
    <PackageTags>metatrader;mt5;mt4;tradecopier;grpc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples\**" />
    <None Include="examples\**" />
  </ItemGroup>
</Project>
